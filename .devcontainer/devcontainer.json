{
  "name": "AI Podcast Studio Workshop",
  "build": {
    "dockerfile": "Dockerfile",
    "context": "."
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-toolsai.jupyter"
      ],
      "settings": {
        "python.defaultInterpreterPath": "/usr/local/bin/python",
        "[python]": {
          "defaultInterpreterPath": "/usr/local/bin/python"
        }
      }
    }
  },
  "postStartCommand": "ollama serve &",
  "forwardPorts": [11434],
  "portsAttributes": {
    "11434": {
      "label": "Ollama",
      "onAutoForward": "silent"
    }
  }
}
