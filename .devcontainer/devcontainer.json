{
  "name": "AI Podcast Studio Workshop",
  "build": {
    "dockerfile": "Dockerfile",
    "context": "."
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python"
      ]
    }
  },
  "postStartCommand": "ollama serve &",
  "forwardPorts": [11434],
  "portsAttributes": {
    "11434": {
      "label": "Ollama",
      "onAutoForward": "silent"
    }
  }
}
